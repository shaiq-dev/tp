# Optional user service. The tp CLI normally starts the daemon on demand when its
# socket is absent. Use this to keep it managed by systemd between commands.
#
#   mkdir -p ~/.config/systemd/user
#   cp contrib/tp.service ~/.config/systemd/user/
#   systemctl --user enable --now tp
#   loginctl enable-linger "$USER"     # keep it running after logout

[Unit]
Description=tp paste daemon
After=network-online.target

[Service]
ExecStart=%h/.local/bin/tp daemon
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/tp %t/tp

[Install]
WantedBy=default.target
